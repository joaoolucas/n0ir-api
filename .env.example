# API Configuration
API_TITLE=n0ir API
API_VERSION=1.0.0
API_PREFIX=/api/v1

# RPC Configuration
RPC_URL=https://base-mainnet.g.alchemy.com/v2/PbEIlFPXdZpA6ld_nxViZD73mlaupBrY

# Cache Configuration (seconds)
CACHE_TTL_TOKEN_INFO=3600
CACHE_TTL_TOKEN_PRICES=60
CACHE_TTL_POOL_DATA=300
CACHE_TTL_POOL_LIST=60

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=False
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Wallet Registry Configuration
WALLET_REGISTRY_CONTRACT_ADDRESS=0xB693920F2ea642020491420dc8Fb03cFbA2f412C
WALLET_REGISTRY_OPERATOR_ADDRESS=0x27f4f543c35ee533A7566663C0207Eb179FbA656
# IMPORTANT: Set this in your .env file, never commit the private key to version control
WALLET_REGISTRY_OPERATOR_PRIVATE_KEY=

# Transaction Configuration
MAX_GAS_PRICE_GWEI=50
GAS_MULTIPLIER=1.2
TRANSACTION_TIMEOUT=300
MAX_RETRY_ATTEMPTS=3